---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ContactForm from "../components/ContactForm.astro";
import Reveal from "../components/Reveal.astro";
import { site } from "../data/site";

const links = [
  {
    label: "Email",
    value: site.email,
    href: `mailto:${site.email}`,
    description: "Best for project inquiries and collaborations.",
  },
  {
    label: "Phone",
    value: site.phone,
    href: `tel:${site.phone.replace(/\s/g, "")}`,
    description: "Available during Nepal Standard Time business hours.",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/sahsantoshh",
    href: site.social.linkedin,
    description: "Connect for professional networking.",
  },
  {
    label: "GitHub",
    value: "github.com/SahSantoshh",
    href: site.social.github,
    description: "Open source and side projects.",
  },
  {
    label: "Medium",
    value: "medium.com/@sahsantoshh",
    href: site.social.medium,
    description: "Technical writing and learnings.",
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Santosh Prasad Sah — Senior Ruby on Rails engineer based in Kathmandu, Nepal."
  pageType="ContactPage"
>
  <section class="page-container page-section">
    <Reveal>
      <SectionHeading
        title="Contact"
        subtitle="Open to senior engineering roles, consulting, and interesting product work."
      />
    </Reveal>

    <Reveal delay={60}>
        <div class="hover-lift mb-8 rounded-2xl border border-ruby/25 bg-surface-card p-5 sm:mb-10 sm:p-8">
        <h2 class="text-lg font-semibold text-white">Recruiters & hiring managers</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Send a message below — no mail client required. I typically respond within one business day.
        </p>
        <div class="mt-6">
          <ContactForm />
        </div>
      </div>
    </Reveal>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        links.map(({ label, value, href, description }, i) => (
          <Reveal delay={i * 70}>
            <a
              href={href}
              target={href.startsWith("http") ? "_blank" : undefined}
              rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="hover-lift group block min-h-[5.5rem] rounded-2xl border border-border bg-surface-card p-6 hover:border-ruby/30 hover:bg-surface-raised"
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-muted">{label}</p>
              <p class="mt-2 font-medium text-white transition group-hover:text-accent">{value}</p>
              <p class="mt-2 text-sm text-muted">{description}</p>
            </a>
          </Reveal>
        ))
      }
    </div>

    <Reveal delay={200} class="mt-12">
      <div class="hover-lift rounded-2xl border border-border bg-surface-raised/60 p-8 text-center">
        <h3 class="text-lg font-semibold text-white">Prefer a resume?</h3>
        <p class="mt-2 text-sm text-muted">Download my full CV with detailed experience and skills.</p>
        <a
          href={site.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mt-6 inline-flex min-h-11 items-center rounded-xl bg-ruby px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-hover"
        >
          Download CV (PDF)
        </a>
      </div>
    </Reveal>

    <Reveal delay={280}>
      <p class="mt-8 text-center text-sm text-muted">{site.location}</p>
    </Reveal>
  </section>
</BaseLayout>
