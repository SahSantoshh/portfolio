---
import BaseLayout from "../layouts/BaseLayout.astro";
import RubyGem from "../components/RubyGem.astro";
import Reveal from "../components/Reveal.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you're looking for doesn't exist."
  noindex
>
  <section class="page-container flex min-h-[60vh] flex-col items-center justify-center py-16 text-center sm:py-24">
    <Reveal>
      <RubyGem size={64} class="gem-glow gem-float mx-auto" />
      <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-ruby">404</p>
      <h1 class="font-serif mt-3 text-3xl font-bold text-white sm:text-4xl">Page not found</h1>
      <p class="mt-4 max-w-md text-pretty text-muted">
        This route doesn't exist. Maybe it was moved, or the URL has a typo.
      </p>
      <div class="mt-8 flex w-full max-w-sm flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center">
        <a
          href="/"
          class="btn-primary inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-ruby px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-hover sm:w-auto"
        >
          Back to home
        </a>
        <a
          href="/contact"
          class="btn-primary inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-border bg-surface-raised px-5 py-2.5 text-sm font-semibold text-white hover:border-ruby/30 sm:w-auto"
        >
          Contact me
        </a>
      </div>
    </Reveal>
  </section>
</BaseLayout>
