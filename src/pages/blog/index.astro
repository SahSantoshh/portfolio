---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Reveal from "../../components/Reveal.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title="Blog"
  description="Technical writing by Santosh Prasad Sah — Rails, PostgreSQL, Hotwire, Kamal, and production engineering."
  pageType="CollectionPage"
>
  <section class="page-container page-section">
    <Reveal>
      <SectionHeading
        title="Blog"
        subtitle="Notes on Rails backends, PostgreSQL performance, Hotwire, and shipping production software."
      />
    </Reveal>

    <div class="space-y-4">
      {
        posts.map((post, i) => (
          <Reveal delay={i * 70}>
            <article class="hover-lift rounded-2xl border border-border bg-surface-card p-6 hover:border-ruby/25 hover:bg-surface-raised">
              <time datetime={post.data.pubDate.toISOString()} class="text-xs font-semibold uppercase tracking-wider text-ruby">
                {formatDate(post.data.pubDate)}
              </time>
              <h2 class="mt-2 font-serif text-xl font-semibold text-white sm:text-2xl">
                <a href={`/blog/${post.id}/`} class="transition hover:text-accent">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-muted">{post.data.description}</p>
              {
                post.data.tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-md bg-surface-raised px-2 py-0.5 text-xs text-muted ring-1 ring-border">
                        {tag}
                      </span>
                    ))}
                  </div>
                )
              }
              <a
                href={`/blog/${post.id}/`}
                class="link-arrow mt-5 inline-flex items-center text-sm font-semibold text-ruby transition hover:text-accent-hover"
              >
                Read article <span aria-hidden="true">→</span>
              </a>
            </article>
          </Reveal>
        ))
      }
    </div>
  </section>
</BaseLayout>
