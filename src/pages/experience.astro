---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import Reveal from "../components/Reveal.astro";
import { experience } from "../data/site";
---

<BaseLayout
  title="Experience"
  description="Professional experience of Santosh Prasad Sah — Senior Software Engineer with a decade in Ruby and web development."
  pageType="WebPage"
>
  <section class="page-container page-section">
    <Reveal>
      <SectionHeading
        title="Experience"
        subtitle="From early-career engineering to senior roles leading technical delivery across enterprise products."
      />
    </Reveal>

    <div class="relative space-y-6">
      <div
        class="absolute left-[1.125rem] top-2 hidden h-[calc(100%-1rem)] w-px bg-border sm:block"
        aria-hidden="true"
      ></div>

      {
        experience.map((job, i) => (
          <Reveal delay={i * 90} class="relative sm:pl-12">
            <span
              class="absolute left-3 top-8 hidden h-3 w-3 -translate-x-1/2 rounded-full border-2 border-ruby bg-surface sm:block"
              aria-hidden="true"
            ></span>
            <ExperienceCard {...job} featured={i === 0} />
          </Reveal>
        ))
      }
    </div>
  </section>
</BaseLayout>
