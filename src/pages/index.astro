---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TechBadge from "../components/TechBadge.astro";
import ProfilePhoto from "../components/ProfilePhoto.astro";
import SocialLinks from "../components/SocialLinks.astro";
import RubyGem from "../components/RubyGem.astro";
import OpenSourceCard from "../components/OpenSourceCard.astro";
import Reveal from "../components/Reveal.astro";
import { getCollection } from "astro:content";
import {
  site,
  skillGroups,
  experience,
  education,
  achievements,
  focusAreas,
  projects,
  openSource,
  contributions,
} from "../data/site";

const recentExperience = experience.slice(0, 3);
const featuredOpenSource = openSource.slice(0, 3);
const featuredContributions = contributions.slice(0, 3);

const blogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<BaseLayout title={site.name} description={site.tagline} type="profile" pageType="ProfilePage">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/60">
    <div
      class="pointer-events-none absolute -left-24 top-1/2 hidden -translate-y-1/2 opacity-20 lg:block"
      aria-hidden="true"
    >
      <RubyGem size={200} class="gem-glow gem-float" />
    </div>
    <div class="relative page-container py-12 sm:py-20 lg:py-24">
      <div class="grid items-center gap-8 sm:gap-12 lg:grid-cols-[1fr_auto] lg:gap-16">
        <div class="hero-stagger order-2 lg:order-1">
          <p class="hero-item mb-4 inline-flex max-w-full items-center gap-2 rounded-full border border-ruby/25 bg-ruby/10 px-3 py-1 text-xs font-medium uppercase tracking-wider text-cream sm:mb-5">
            <RubyGem size={14} class="gem-pulse shrink-0" />
            <span class="truncate">Ruby · Rails · PostgreSQL</span>
          </p>
          <h1 class="hero-item font-serif max-w-3xl text-3xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
            {site.name}
          </h1>
          <p class="hero-item mt-3 text-lg font-semibold text-ruby sm:mt-4 sm:text-2xl">{site.title}</p>
          <p class="hero-item mt-4 max-w-2xl text-base leading-relaxed text-muted sm:mt-6 sm:text-lg">{site.tagline}</p>

          <div class="hero-item mt-8">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">Primary stack</p>
            <div class="flex flex-wrap gap-2">
              {site.primaryStack.map((tech) => (
                <TechBadge name={tech} size="md" />
              ))}
            </div>
          </div>

          <div class="hero-item mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap sm:items-center">
            <a
              href={site.resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-ruby px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-hover sm:w-auto"
            >
              Download CV
            </a>
            <a
              href="/projects"
              class="btn-primary inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-border bg-surface-raised px-5 py-2.5 text-sm font-semibold text-white hover:border-ruby/30 sm:w-auto"
            >
              View projects
            </a>
            <a
              href={site.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="link-arrow inline-flex min-h-11 w-full items-center justify-center rounded-xl px-5 py-2.5 text-sm font-medium text-muted transition hover:text-ruby sm:w-auto"
            >
              GitHub <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="hero-item mt-8 text-sm text-muted">{site.location}</p>
        </div>

        <div class="hero-item order-1 flex justify-center lg:order-2 lg:justify-end">
          <ProfilePhoto
            src={site.photos.profile}
            alt={`${site.name} — Ruby on Rails engineer`}
            size="hero"
            class="hero-photo"
          />
        </div>
      </div>
    </div>
    <div class="rails-track page-container" aria-hidden="true"></div>
  </section>

  <!-- About -->
  <Reveal class="page-container page-section">
    <SectionHeading title="About" subtitle="A decade in the Ruby ecosystem — shipping production Rails apps." />
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_280px]">
      <div class="max-w-3xl">
        <p class="text-base leading-relaxed text-muted">{site.summary}</p>
        <div class="mt-8">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">Find me online</p>
          <SocialLinks />
        </div>
      </div>
      <Reveal delay={80}>
        <figure>
          <ProfilePhoto src={site.photos.travel} alt={`${site.name} — International Olympiad in Linguistics`} size="lg" class="mx-auto lg:mx-0" />
          <figcaption class="mt-2 text-center text-xs text-muted lg:text-left">IOL 2025 · Taiwan</figcaption>
        </figure>
      </Reveal>
    </div>
  </Reveal>

  <!-- Focus -->
  <section class="border-y border-border/60 bg-surface-raised/40">
    <div class="page-container page-section">
      <Reveal>
        <SectionHeading title="Rails craft" subtitle="Where I spend most of my engineering time." />
      </Reveal>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          focusAreas.map(({ title, description, icon }, i) => (
            <Reveal delay={i * 80}>
              <div class="hover-lift rounded-2xl border border-border bg-surface-card p-6 hover:border-ruby/25">
                <div class="mb-3">
                  <TechBadge name={icon} size="sm" />
                </div>
                <h3 class="font-semibold text-white">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{description}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="border-t border-border/60 bg-surface-raised/30">
    <div class="page-container page-section">
      <Reveal class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="font-serif text-2xl font-semibold tracking-tight text-white sm:text-3xl">Side projects</h2>
          <p class="mt-2 max-w-2xl text-muted">Rails backends, mobile clients — built outside day jobs.</p>
          <div class="mt-4 h-px w-12 bg-gradient-to-r from-ruby to-transparent" aria-hidden="true"></div>
        </div>
        <a href="/projects" class="link-arrow shrink-0 text-sm font-medium text-ruby transition hover:text-accent-hover">
          View all projects <span aria-hidden="true">→</span>
        </a>
      </Reveal>
      <Reveal delay={100}>
        {
          projects
            .filter((p) => p.featured)
            .map((project) => (
              <ProjectCard
                name={project.name}
                tagline={project.tagline}
                description={project.description}
                url={project.url}
                icon={project.icon}
                playStoreUrl={project.playStoreUrl}
                playStoreIcon={project.playStoreIcon}
                stack={project.stack}
                featured
              />
            ))
        }
      </Reveal>
    </div>
  </section>

  <!-- Open source -->
  <section class="border-t border-border/60">
    <div class="page-container page-section">
      <Reveal class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="font-serif text-2xl font-semibold tracking-tight text-white sm:text-3xl">Open source</h2>
          <p class="mt-2 max-w-2xl text-muted">A published Rails gem, GitHub projects, and contributions to upstream open source.</p>
          <div class="mt-4 h-px w-12 bg-gradient-to-r from-ruby to-transparent" aria-hidden="true"></div>
        </div>
        <a href="/open-source" class="link-arrow shrink-0 text-sm font-medium text-ruby transition hover:text-accent-hover">
          All repositories <span aria-hidden="true">→</span>
        </a>
      </Reveal>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredOpenSource.map((repo, i) => (
            <Reveal delay={i * 80}>
              <OpenSourceCard {...repo} kind="project" />
            </Reveal>
          ))
        }
      </div>

      <Reveal delay={200} class="mt-12">
        <h3 class="mb-6 text-sm font-semibold uppercase tracking-wider text-muted">Contributions</h3>
      </Reveal>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredContributions.map((repo, i) => (
            <Reveal delay={240 + i * 80}>
              <OpenSourceCard {...repo} kind="contribution" />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Latest writing -->
  {
    blogPosts.length > 0 && (
      <section class="border-t border-border/60 bg-surface-raised/30">
        <div class="page-container page-section">
          <Reveal class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h2 class="font-serif text-2xl font-semibold tracking-tight text-white sm:text-3xl">Latest writing</h2>
              <p class="mt-2 max-w-2xl text-muted">Rails, PostgreSQL, Hotwire, and production engineering notes.</p>
              <div class="mt-4 h-px w-12 bg-gradient-to-r from-ruby to-transparent" aria-hidden="true"></div>
            </div>
            <a href="/blog" class="link-arrow shrink-0 text-sm font-medium text-ruby transition hover:text-accent-hover">
              All posts <span aria-hidden="true">→</span>
            </a>
          </Reveal>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              blogPosts.map((post, i) => (
                <Reveal delay={i * 80}>
                  <article class="hover-lift flex h-full flex-col rounded-2xl border border-border bg-surface-card p-6 hover:border-ruby/25">
                    <time datetime={post.data.pubDate.toISOString()} class="text-xs font-semibold uppercase tracking-wider text-ruby">
                      {formatDate(post.data.pubDate)}
                    </time>
                    <h3 class="mt-2 font-serif text-lg font-semibold text-white">
                      <a href={`/blog/${post.id}/`} class="transition hover:text-accent">
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{post.data.description}</p>
                    <a
                      href={`/blog/${post.id}/`}
                      class="link-arrow mt-4 inline-flex items-center text-sm font-semibold text-ruby transition hover:text-accent-hover"
                    >
                      Read <span aria-hidden="true">→</span>
                    </a>
                  </article>
                </Reveal>
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- Skills -->
  <Reveal class="page-container page-section">
    <SectionHeading title="Toolbox" subtitle="Technologies I reach for regularly." />
    <div class="grid gap-8 sm:grid-cols-2">
      {
        skillGroups.map(({ title, items }, i) => (
          <Reveal delay={i * 100}>
            <div>
              <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-ruby/80">{title}</h3>
              <div class="flex flex-wrap gap-2">
                {items.map((skill) => (
                  <TechBadge name={skill} size="sm" />
                ))}
              </div>
            </div>
          </Reveal>
        ))
      }
    </div>
  </Reveal>

  <!-- Recent experience -->
  <section class="border-t border-border/60 bg-surface-raised/30">
    <div class="page-container page-section">
      <Reveal class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="font-serif text-2xl font-semibold tracking-tight text-white sm:text-3xl">Experience</h2>
          <p class="mt-2 max-w-2xl text-muted">A decade across product companies and research labs.</p>
          <div class="mt-4 h-px w-12 bg-gradient-to-r from-ruby to-transparent" aria-hidden="true"></div>
        </div>
        <a href="/experience" class="link-arrow shrink-0 text-sm font-medium text-ruby transition hover:text-accent-hover">
          Full timeline <span aria-hidden="true">→</span>
        </a>
      </Reveal>
      <div class="space-y-4">
        {
          recentExperience.map((job, i) => (
            <Reveal delay={i * 90}>
              <ExperienceCard {...job} featured={i === 0} />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Education & awards -->
  <div class="page-container page-section">
    <div class="grid gap-10 sm:grid-cols-2">
      <Reveal>
        <SectionHeading title="Education" />
        <div class="hover-lift rounded-2xl border border-border bg-surface-card p-6">
          <h3 class="font-semibold text-white">{education.degree}</h3>
          <p class="mt-1 text-sm text-muted">{education.school}</p>
          <p class="mt-2 text-sm text-ruby">{education.period}</p>
        </div>
      </Reveal>
      <Reveal delay={120}>
        <SectionHeading title="Achievements" />
        <ul class="space-y-3">
          {
            achievements.map((item) => (
              <li class="hover-lift flex gap-3 rounded-2xl border border-border bg-surface-card p-4 text-sm leading-relaxed text-muted">
                <RubyGem size={16} class="mt-0.5 shrink-0 gem-pulse" />
                {item}
              </li>
            ))
          }
        </ul>
      </Reveal>
    </div>
  </div>
</BaseLayout>
