---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import OpenSourceCard from "../components/OpenSourceCard.astro";
import Reveal from "../components/Reveal.astro";
import { openSource, contributions, site } from "../data/site";
---

<BaseLayout
  title="Open Source"
  description="Open source projects and upstream contributions by Santosh Prasad Sah — Ruby, Rails, Flutter, and Salesforce integration."
  pageType="CollectionPage"
>
  <section class="page-container page-section">
    <Reveal>
      <SectionHeading
        title="Open source"
        subtitle="Side projects on GitHub and contributions to upstream open source — beyond employer work and Kharcha Diary."
      />
    </Reveal>

    <Reveal delay={40}>
      <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-muted">My projects</h2>
    </Reveal>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        openSource.map((repo, i) => (
          <Reveal delay={i * 70}>
            <OpenSourceCard {...repo} kind="project" />
          </Reveal>
        ))
      }
    </div>

    <Reveal delay={80} class="mt-16">
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Contributions</h2>
        <a
          href={site.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="link-arrow text-sm font-medium text-ruby transition hover:text-accent-hover"
        >
          All repos on GitHub <span aria-hidden="true">→</span>
        </a>
      </div>
    </Reveal>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        contributions.map((repo, i) => (
          <Reveal delay={120 + i * 70}>
            <OpenSourceCard {...repo} kind="contribution" />
          </Reveal>
        ))
      }
    </div>
  </section>
</BaseLayout>
