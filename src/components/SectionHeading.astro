---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-8 sm:mb-10">
  <h2 class="text-balance text-2xl font-semibold tracking-tight text-white sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-2 max-w-2xl text-pretty text-sm leading-relaxed text-muted sm:text-base">{subtitle}</p>}
  <div class="mt-4 h-px w-12 bg-gradient-to-r from-ruby to-transparent" aria-hidden="true"></div>
</div>
