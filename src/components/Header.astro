---
import { nav, site } from "../data/site";
import RubyGem from "./RubyGem.astro";
import TechBadge from "./TechBadge.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-surface/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="group flex items-center gap-2.5">
      <RubyGem size={28} class="gem-glow gem-pulse transition duration-300 group-hover:scale-110" />
      <span class="hidden flex-col sm:flex">
        <span class="text-sm font-semibold tracking-tight text-white">{site.name}</span>
        <span class="text-xs text-ruby">Ruby on Rails</span>
      </span>
    </a>

    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-1">
        {
          nav.map(({ href, label }) => {
            const isActive =
              href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(href);
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    "nav-link rounded-lg px-3 py-2 text-sm font-medium",
                    isActive
                      ? "bg-ruby/15 text-white ring-1 ring-ruby/25"
                      : "text-muted hover:bg-surface-raised hover:text-white",
                  ]}
                  aria-current={isActive ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
