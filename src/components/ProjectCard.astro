---
import TechBadge from "./TechBadge.astro";

interface Props {
  name: string;
  tagline: string;
  description: string;
  url: string;
  icon?: string;
  appStoreUrl?: string;
  playStoreUrl?: string;
  playStoreIcon?: string;
  stack: string[];
  featured?: boolean;
}

const { name, tagline, description, url, icon, appStoreUrl, playStoreUrl, playStoreIcon, stack, featured = false } =
  Astro.props;
---

<article
  class:list={[
    "hover-lift group flex flex-col rounded-2xl border p-5 transition sm:p-8",
    featured
      ? "border-ruby/35 bg-surface-card ring-1 ring-ruby/15"
      : "border-border bg-surface-card/60 hover:border-ruby/20 hover:bg-surface-card",
  ]}
>
  <div class="flex flex-1 flex-col">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
      {
        icon && (
          <img
            src={icon}
            alt={`${name} icon`}
            width={64}
            height={64}
            class="h-14 w-14 shrink-0 rounded-2xl bg-surface-raised object-contain ring-1 ring-border sm:h-16 sm:w-16"
            loading="lazy"
          />
        )
      }
      <div class="min-w-0 flex-1">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wider text-ruby">Side project</p>
            <h3 class="mt-2 text-xl font-semibold text-white sm:text-2xl">{name}</h3>
            <p class="mt-1 text-sm font-medium text-accent">{tagline}</p>
          </div>
          <span
            class="inline-flex w-fit shrink-0 rounded-lg bg-emerald-400/10 px-2.5 py-1 text-xs font-medium text-emerald-400 ring-1 ring-emerald-400/20"
          >
            Live
          </span>
        </div>
      </div>
    </div>

    <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{description}</p>

    <div class="mt-5">
      <p class="mb-2.5 text-xs font-semibold uppercase tracking-wider text-muted">Stack</p>
      <div class="flex flex-wrap gap-2">
        {stack.map((tech) => (
          <TechBadge name={tech} size="sm" />
        ))}
      </div>
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-3 border-t border-border/60 pt-6 sm:flex-row sm:flex-wrap">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-ruby px-4 py-2.5 text-sm font-semibold text-white hover:bg-accent-hover sm:w-auto"
    >
      Visit website →
    </a>
    {
      appStoreUrl && (
        <a
          href={appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-border bg-surface-raised px-4 py-2.5 text-sm font-semibold text-white transition hover:border-ruby/30 sm:w-auto"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
            <path
              fill="currentColor"
              d="M16.37 12.72c.03 2.9 2.54 3.86 2.57 3.88-.02.07-.4 1.37-1.32 2.71-.8 1.16-1.63 2.32-2.94 2.34-1.29.02-1.7-.76-3.17-.76s-1.93.74-3.15.78c-1.26.05-2.22-1.26-3.03-2.41-1.65-2.37-2.91-6.69-1.22-9.61.84-1.45 2.34-2.37 3.97-2.39 1.24-.02 2.41.83 3.17.83.76 0 2.18-1.03 3.67-.88.63.03 2.38.25 3.51 1.9-.09.06-2.1 1.22-2.06 3.61M14.4 6.3c.66-.8 1.1-1.91.98-3.02-1 .04-2.2.66-2.91 1.46-.64.73-1.2 1.9-1.05 3.02 1.11.09 2.24-.56 2.98-1.46"
            />
          </svg>
          App Store
        </a>
      )
    }
    {
      playStoreUrl && (
        <a
          href={playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-border bg-surface-raised px-4 py-2.5 text-sm font-semibold text-white transition hover:border-ruby/30 sm:w-auto"
        >
          {
            playStoreIcon ? (
              <img src={playStoreIcon} alt="" width={20} height={20} class="h-5 w-5" loading="lazy" />
            ) : null
          }
          Google Play
        </a>
      )
    }
  </div>
</article>
