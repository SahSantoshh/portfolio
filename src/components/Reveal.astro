---
interface Props {
  delay?: number;
  class?: string;
  as?: "div" | "section" | "li" | "article";
}

const { delay = 0, class: className, as: Tag = "div" } = Astro.props;
---

<Tag
  class:list={["reveal", className]}
  data-reveal
  style={delay > 0 ? `--reveal-delay: ${delay}ms` : undefined}
>
  <slot />
</Tag>
