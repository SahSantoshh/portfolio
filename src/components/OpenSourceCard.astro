---
import TechBadge from "./TechBadge.astro";

interface Props {
  name: string;
  description: string;
  url: string;
  language: string;
  stars?: number;
  topics?: string[];
  kind?: "project" | "contribution";
  upstream?: string;
  upstreamUrl?: string;
}

const {
  name,
  description,
  url,
  language,
  stars = 0,
  topics = [],
  kind = "project",
  upstream,
  upstreamUrl,
} = Astro.props;

const label = kind === "contribution" ? "Contribution" : "Open source";
---

<article class="hover-lift group flex h-full flex-col rounded-2xl border border-border bg-surface-card p-5 hover:border-ruby/25 hover:bg-surface-raised sm:p-6">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-ruby">{label}</p>
      <h3 class="mt-2 break-words font-mono text-lg font-semibold text-white transition group-hover:text-accent sm:text-xl">
        {name}
      </h3>
      {
        upstream && upstreamUrl && (
          <p class="mt-1 break-all text-xs text-muted">
            <a href={upstreamUrl} target="_blank" rel="noopener noreferrer" class="transition hover:text-ruby">
              {upstream}
            </a>
          </p>
        )
      }
    </div>
    {
      stars > 0 && (
        <span class="shrink-0 rounded-lg bg-surface-raised px-2.5 py-1 text-xs font-medium text-muted ring-1 ring-border">
          ★ {stars}
        </span>
      )
    }
  </div>

  <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{description}</p>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <TechBadge name={language} size="sm" />
    {
      topics.slice(0, 3).map((topic) => (
        <span class="rounded-md bg-surface-raised px-2 py-0.5 text-xs text-muted ring-1 ring-border">
          {topic}
        </span>
      ))
    }
  </div>

  <div class="mt-6 border-t border-border/60 pt-5">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="link-arrow inline-flex items-center text-sm font-semibold text-ruby transition hover:text-accent-hover"
    >
      View on GitHub <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
