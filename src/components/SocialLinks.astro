---
import { site } from "../data/site";

const links = [
  {
    label: "GitHub",
    href: site.social.github,
    iconUrl: "https://cdn.simpleicons.org/github/FFFFFF",
  },
  {
    label: "LinkedIn",
    href: site.social.linkedin,
    icon: "linkedin",
  },
  {
    label: "Medium",
    href: site.social.medium,
    iconUrl: "https://cdn.simpleicons.org/medium/FFFFFF",
  },
];
---

<div class="flex flex-wrap gap-3">
  {
    links.map(({ label, href, iconUrl, icon }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer me"
        class="btn-primary hover-lift inline-flex min-h-11 items-center gap-2.5 rounded-xl border border-border bg-surface-raised px-4 py-2.5 text-sm font-semibold text-white transition hover:border-ruby/30"
      >
        {
          icon === "linkedin" ? (
            <svg
              class="h-5 w-5 shrink-0"
              viewBox="0 0 24 24"
              fill="#0A66C2"
              aria-hidden="true"
            >
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.062 2.062 0 0 1 2.063-2.063 2.062 2.062 0 0 1 2.063 2.063 2.062 2.062 0 0 1-2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          ) : (
            <img
              src={iconUrl}
              alt=""
              width={20}
              height={20}
              class="h-5 w-5 shrink-0 object-contain"
              loading="lazy"
            />
          )
        }
        {label}
      </a>
    ))
  }
</div>
