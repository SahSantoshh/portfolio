---
interface Props {
  role: string;
  company: string;
  period: string;
  highlights: string[];
  featured?: boolean;
}

const { role, company, period, highlights, featured = false } = Astro.props;
---

<article
  class:list={[
    "rounded-2xl border p-6 transition",
    featured
      ? "border-ruby/30 bg-surface-card ring-1 ring-ruby/10"
      : "border-border bg-surface-card/60 hover:border-border/80 hover:bg-surface-card",
  ]}
>
  <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h3 class="text-lg font-semibold text-white">{role}</h3>
      <p class="text-accent">{company}</p>
    </div>
    <time class="mt-1 shrink-0 text-sm text-muted sm:mt-0">{period}</time>
  </div>
  <ul class="mt-4 space-y-2">
    {
      highlights.map((item) => (
        <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
          <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ruby/70" aria-hidden="true"></span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</article>
